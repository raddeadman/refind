# Copy to .env and change every password. .env is git-ignored.

# --- MongoDB (docker compose + scripts) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=refind
MONGO_TEST_DB=refind_test
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
# Least-privilege accounts created by scripts/setup_db.py (§5.1)
MONGO_APP_PASSWORD=change-me-app
MONGO_ADMIN_PASSWORD=change-me-admin
MONGO_REPORTS_PASSWORD=change-me-reports
MONGO_BACKUP_PASSWORD=change-me-backup

# --- API ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
ALLOWED_EMAIL_DOMAINS=["university.edu"]
SMTP_HOST=localhost
SMTP_PORT=1025
ENABLE_SCHEDULER=true
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
EMAIL_FROM=ReFind <no-reply@refind.local>
# Google sign-in (optional): create an OAuth client at console.cloud.google.com
# Authorised redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
